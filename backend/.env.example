# Copy this file to ".env" and change values if needed.
# Never put real secrets in this file. Only ".env.example" is committed to Git.

# Where Ollama is running on your computer
OLLAMA_BASE_URL=http://localhost:11434

# Which Gemma model to use (run "ollama pull <name>" first, from Stage 4)
OLLAMA_MODEL=gemma3:4b

# Frontend addresses allowed to call the backend (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Full path to tesseract.exe if it is not on your PATH (used from Stage 3)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
